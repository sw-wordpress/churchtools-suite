<?xml version="1.0"?>
<phpunit bootstrap="bootstrap.php" colors="true" failOnRisky="true" failOnWarning="true" convertDeprecationsToExceptions="false">
    <testsuites>
        <testsuite name="wordpress">
            <file>tests/CTS_TestCase.php</file>
            <file>tests/SmokeTest.php</file>
            <file>tests/AdminRegressionTest.php</file>
            <file>tests/AdminSettingsTest.php</file>
            <file>tests/AdminScreenRegistryTest.php</file>
            <file>tests/AdminPageShellTest.php</file>
            <file>tests/ConnectionStateTest.php</file>
            <file>tests/SyncRepositoryTest.php</file>
            <file>tests/ConnectionSettingsTest.php</file>
            <file>tests/ConnectionPreviewTest.php</file>
            <file>tests/AdminUiStyleTest.php</file>
            <file>tests/AdminDesignSystemTest.php</file>
            <file>tests/TerminologyTest.php</file>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">../../admin</directory>
            <directory suffix=".php">../../includes</directory>
            <directory suffix=".php">../../templates</directory>
            <file>../../churchtools-suite.php</file>
            <directory suffix=".php">../../addons</directory>
        </include>
    </coverage>
</phpunit>
